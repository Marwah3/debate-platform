generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum users_role {
  user
  admin
}

model argumens {
  id_argumen   Int       @id @default(autoincrement())
  id_user      Int?
  teks_argumen String    @db.Text
  skor_AREL    Int?      @default(0)
  feedback_ai  String?   @db.Text
  xp_diperoleh Int?      @default(0)
  timestamp    DateTime? @default(now()) @db.Timestamp(0)
  users        users?    @relation(fields: [id_user], references: [id_user], onDelete: Cascade, onUpdate: NoAction, map: "argumens_ibfk_1")

  @@index([id_user], map: "id_user")
}

model badges {
  id_log        Int       @id @default(autoincrement())
  id_user       Int?
  nama_badge    String    @db.VarChar(100)
  deskripsi     String?   @db.Text
  tanggal_dapat DateTime? @default(now()) @db.Timestamp(0)
  users         users?    @relation(fields: [id_user], references: [id_user], onDelete: Cascade, onUpdate: NoAction, map: "badges_ibfk_1")

  @@index([id_user], map: "id_user")
}

model moduls {
  id_modul      Int       @id @default(autoincrement())
  judul         String    @db.VarChar(150)
  konten_materi String?    @db.Text // ← DIBUAT OPSIONAL (?)
  status_lock   Boolean?  @default(true)
  urutan        Int?       // ← DIBUAT OPSIONAL (?)
  bahasa        String    @default("id")
  created_at    DateTime  @default(now())
  quizzes       quizzes[]
}

model quizzes {
  id_quiz       Int     @id @default(autoincrement())
  id_modul      Int?
  pertanyaan    String  @db.Text
  kunci_jawaban String  @db.VarChar(255)
  bobot_xp      Int?    @default(30)
  moduls        moduls? @relation(fields: [id_modul], references: [id_modul], onDelete: Cascade, onUpdate: NoAction, map: "quizzes_ibfk_1")

  @@index([id_modul], map: "id_modul")
}

model users {
  id_user        Int        @id @default(autoincrement())
  nama           String     @db.VarChar(100)
  email          String     @unique(map: "email") @db.VarChar(100)
  password       String     @db.VarChar(255)
  role           users_role @default(user)
  total_xp       Int?       @default(0)
  current_level  Int?       @default(1)
  tanggal_daftar DateTime?  @default(now()) @db.Timestamp(0)
  argumens       argumens[]
  badges         badges[]
  notes          notes[]    // ← Relasi timbal balik sudah benar
}


model motions {
  id_motion  Int      @id @default(autoincrement())
  teks       String   @db.Text
  jenis      String
  bahasa     String   @default("id")
  created_at DateTime @default(now())
}

model notes {
  id_note       Int      @id @default(autoincrement())
  id_user       Int
  judul_catatan String
  isi_catatan   String   @db.Text
  created_at    DateTime @default(now())
  user          users    @relation(fields: [id_user], references: [id_user], onDelete: Cascade, onUpdate: NoAction, map: "notes_ibfk_1")

  @@index([id_user], map: "id_user")
}

model landing_stats {
  id_stats       Int     @id @default(autoincrement())
  total_anggota  String  @default("48+") @db.VarChar(50)
  total_prestasi String  @default("12") @db.VarChar(50)
  total_lomba    String  @default("20+") @db.VarChar(50)
  hero_img       String? @db.Text
}

model anggota {
  id_anggota Int       @id @default(autoincrement())
  nama       String    @db.VarChar(150)
  posisi     String    @db.VarChar(100)
  inisial    String    @db.VarChar(10)
  created_at DateTime? @default(now())
}

model prestasi {
  id_prestasi   Int       @id @default(autoincrement())
  juara         String    @db.VarChar(100)
  lomba         String    @db.VarChar(200)
  tahun         String    @db.VarChar(20)
  penyelenggara String    @db.VarChar(200)
  img_url       String?   @db.Text
  created_at    DateTime? @default(now())
}

model berita_acara {
  id_berita  Int       @id @default(autoincrement())
  title      String    @db.VarChar(200)
  date       String    @db.VarChar(100)
  tag        String    @db.VarChar(50)
  desc       String?   @db.Text
  img_url    String?   @db.Text
  created_at DateTime? @default(now())
}

model lomba {
  id_lomba   Int     @id @default(autoincrement())
  nama_lomba String
  kategori   String?
  lokasi     String
  image_url  String?
}